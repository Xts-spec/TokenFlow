{
  "name": "tokenflow",
  "version": "10.15.26",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "workspaces": [
    "packages/contracts",
    "packages/codebuddy-runtime"
  ],
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "serve": "node dist/headless.js",
    "build": "tsup && vite build --config apps/console/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "browser:install": "playwright install chromium",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "package": "npm run build && electron-builder --dir --publish never",
    "package:win": "node scripts/build-sidecar.mjs win32-x64 && npm run build && electron-builder --win zip --x64 --publish never",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "prebuild": "node scripts/clean-build.mjs",
    "test:login": "node scripts/login-smoke.mjs",
    "test:design": "node scripts/design-smoke.mjs",
    "test:gateway": "node scripts/gateway-smoke.mjs",
    "test:a2a": "node scripts/a2a-smoke.mjs",
    "test:sidecar-pin": "node scripts/test-sidecar-pin.mjs",
    "test:sidecar-qoder": "node scripts/test-sidecar-qoder.mjs",
    "test:sidecar-agents": "node scripts/test-sidecar-qoder.mjs",
    "test:claude-compat": "go -C upstream/CLIProxyAPI test ./internal/translator/codex/claude ./internal/translator/openai/claude && npm run test:sidecar-agents",
    "test:api-sources": "node scripts/api-sources-smoke.mjs",
    "test:repair": "node scripts/local-repair-smoke.mjs",
    "pretest:frontend": "npm run build",
    "test:frontend": "node scripts/flow-ui-smoke.mjs",
    "test:agent-installation-ui": "node scripts/agent-installation-ui-smoke.mjs",
    "package:mac:arm64": "node scripts/build-sidecar.mjs darwin-arm64 && npm run build && electron-builder --mac --arm64 --dir --publish never",
    "package:mac:intel": "node scripts/build-sidecar.mjs darwin-x64 && npm run build && electron-builder --mac --x64 --dir --publish never",
    "test:notification-hit": "node scripts/notification-hit-smoke.mjs",
    "test:usage-overview": "node scripts/usage-overview-ui-smoke.mjs",
    "test:key-detail-return": "node scripts/key-detail-return-smoke.mjs",
    "test:cards": "node scripts/card-interface-ui-smoke.mjs",
    "test:refinement": "node scripts/refinement-ui-smoke.mjs",
    "icon:render": "node scripts/render-app-icon.mjs"
  },
  "dependencies": {
    "@cua-sample/contracts": "*",
    "@cursor/sdk": "1.0.31",
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.1",
    "openai": "^6.25.0",
    "playwright": "^1.55.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smol-toml": "^1.4.2",
    "typebox": "1.3.27",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^3.24.2",
    "@token-flow/codebuddy-runtime": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "tsup": "^8.4.0",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "buildVersion": "10.15.26.3",
    "appId": "local.browseragent.desktop",
    "productName": "TokenFlow",
    "files": [
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/playwright*/**",
      "node_modules/@token-flow/codebuddy-runtime/**",
      "node_modules/@tencent-ai/agent-sdk/**",
      "packages/codebuddy-runtime/**"
    ],
    "extraResources": [
      {
        "from": "sidecars",
        "to": "sidecars"
      },
      {
        "from": "LICENSES",
        "to": "LICENSES"
      },
      {
        "from": "extensions/chrome",
        "to": "extensions/chrome"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "apps/console/public/app-icon.png"
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "apps/console/public/app-icon.png"
    },
    "directories": {
      "output": "release"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Local desktop model gateway: manage accounts and APIs, connect models to coding agents, and export scoped client keys.",
  "author": "haruinia"
}
